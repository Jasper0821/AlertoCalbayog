 MONGO_URI=mongodb://localhost:27017/alertocalbayog
# Gmail account and 16-character Google App Password used for system emails.
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASS=your_16_char_app_password
# Automatically close resolved reports after 7 or 14 days. Defaults to 14.
RESOLVED_AUTO_CLOSE_DAYS=14

# Cloudinary — hosts incident evidence photos (resident proof + responder resolution).
# Get these from the Dashboard at cloudinary.com after signing up (free tier is ample).
# BACKEND ONLY. Never put the API secret in web/.env or mobile/.env — Vite and Expo
# compile those into the client bundle, which would publish the secret to every user.
# Without these the app still works but stores photos inline as base64, which
# MongoDB caps at 16MB per report.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
