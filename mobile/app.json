{
  "expo": {
    "name": "Alerto Calbayog",
    "slug": "alertocalbayog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#04112b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alertocalbayog.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Alerto Calbayog needs your location to send emergency reports to nearby responders."
      }
    },
    "android": {
      "package": "com.alertocalbayog.mobile",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#04112b"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "scheme": "alertocalbayog",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Alerto Calbayog needs your location to send emergency reports to nearby responders."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Alerto Calbayog needs access to your photos to attach emergency proof photos.",
          "cameraPermission": "Alerto Calbayog needs access to your camera to take emergency proof photos."
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "7f485b2e-a4ae-4bf4-9649-72b2df7c0885"
      }
    },
    "owner": "jasper0821"
  }
}
